{
  "name": "@imgeekk/clark",
  "version": "0.1.1",
  "description": "Mine engineering decisions from git history and serve them to coding agents over MCP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imgeekk/clark.git"
  },
  "homepage": "https://github.com/imgeekk/clark#readme",
  "bugs": {
    "url": "https://github.com/imgeekk/clark/issues"
  },
  "bin": {
    "clark": "./bin/clark.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "test": "tsx --test src/verify.test.ts src/git.test.ts src/embeddings.test.ts src/retrieval.test.ts src/mcp.test.ts src/gemini.test.ts src/status.test.ts src/mcp-config.test.ts",
    "ingest": "tsx src/ingest.ts",
    "extract": "tsx src/extract.ts",
    "index": "tsx src/indexer.ts",
    "status": "tsx src/status.ts",
    "init": "tsx src/init.ts",
    "serve": "tsx src/serve.ts",
    "why": "tsx src/why.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "history",
    "decisions",
    "mcp",
    "ai",
    "agent",
    "sqlite",
    "gemini"
  ],
  "author": "imgeekk",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.11.1",
    "zod": "^4.6.7"
  }
}
